{
  "name": "appa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run build:runtime && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json --noEmit",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "dev": "vite",
    "build": "npm run typecheck && npm run build:runtime && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "desktop:dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^7.0.2",
    "vite": "6.4.2"
  },
  "description": "Appa, a local personal planning assistant with optional AI planning through your own ChatGPT account.",
  "main": "dist/runtime/desktop/main.js",
  "license": "MIT",
  "author": "ZiWang",
  "repository": {
    "type": "git",
    "url": "https://github.com/ellenWang918/appa.git"
  },
  "engines": {
    "node": ">=22"
  }
}
